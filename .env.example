# 环境配置示例
# 复制此文件为 .env 并修改配置

# 应用环境
APP_ENV=production

# 安全密钥 - 生产环境必须修改
SECRET_KEY=your-secret-key-change-in-production

# 存储类型: local (本地内存) 或 dynamodb (AWS DynamoDB)
STORAGE_TYPE=local

# DynamoDB 配置 (仅当 STORAGE_TYPE=dynamodb 时需要)
# AWS_REGION=ap-northeast-1
# DYNAMODB_USERS_TABLE=ipc-cost-users
# DYNAMODB_EVALUATIONS_TABLE=ipc-cost-evaluations
