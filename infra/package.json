{
  "name": "ipc-cost-evaluator-infra",
  "version": "1.0.0",
  "description": "AWS CDK infrastructure for IPC Case Cost Evaluator",
  "bin": {
    "infra": "bin/app.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "synth": "cdk synth",
    "synth:dev": "cdk synth -c environment=dev",
    "synth:staging": "cdk synth -c environment=staging",
    "synth:prod": "cdk synth -c environment=prod",
    "deploy": "cdk deploy --all",
    "deploy:dev": "cdk deploy --all -c environment=dev --require-approval never",
    "deploy:staging": "cdk deploy --all -c environment=staging --require-approval broadening",
    "deploy:prod": "cdk deploy --all -c environment=prod",
    "destroy": "cdk destroy --all",
    "destroy:dev": "cdk destroy --all -c environment=dev --force",
    "destroy:staging": "cdk destroy --all -c environment=staging --force",
    "destroy:prod": "cdk destroy --all -c environment=prod",
    "diff": "cdk diff",
    "diff:dev": "cdk diff -c environment=dev",
    "diff:staging": "cdk diff -c environment=staging",
    "diff:prod": "cdk diff -c environment=prod",
    "bootstrap": "cdk bootstrap",
    "list": "cdk list",
    "list:dev": "cdk list -c environment=dev",
    "list:staging": "cdk list -c environment=staging",
    "list:prod": "cdk list -c environment=prod"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "~5.3.0",
    "aws-cdk": "^2.120.0",
    "ts-node": "^10.9.2",
    "source-map-support": "^0.5.21"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.120.0",
    "constructs": "^10.3.0"
  }
}
